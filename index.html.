<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lartos Cup - Fortnite Duo</title>
  <style>
    body {
      margin: 0;
      padding: 30px;
      font-family: Arial, sans-serif;
      background: #111827;
      color: white;
    }
    h1 { color: #facc15; }
    .carte {
      background: #1f2937;
      padding: 20px;
      border-radius: 12px;
      margin-top: 20px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }
    th, td {
      padding: 12px;
      border-bottom: 1px solid #374151;
      text-align: left;
    }
    th { color: #facc15; }
  </style>
</head>
<body>
  <h1>🏆 LARTOS CUP</h1>
  <p>Classement officiel Fortnite Duo</p>

  <div class="carte">
    <h2>Classement des équipes</h2>
    <table>
      <thead>
        <tr>
          <th>Rang</th>
          <th>Équipe</th>
          <th>Éliminations</th>
          <th>Points</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>1</td>
          <td>Équipe exemple</td>
          <td>10</td>
          <td>25</td>
        </tr>
        <tr>
          <td>2</td>
          <td>Équipe exemple 2</td>
          <td>7</td>
          <td>18</td>
        </tr>
      </tbody>
    </table>
  </div>
</body>
</html>
